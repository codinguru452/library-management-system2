# PostgreSQL connection string from your hosted database provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Use a long, random secret. Never commit your real .env file.
JWT_SECRET="replace-this-with-a-long-random-secret"

# Optional: set both values before running `npm run prisma:seed`
# to create or update a LIBRARIAN account.
LIBRARIAN_EMAIL="librarian@example.com"
LIBRARIAN_PASSWORD="replace-with-a-strong-password"

# Optional; Nest defaults to port 3000
PORT=3000
